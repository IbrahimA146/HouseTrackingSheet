rules_version = '2';

// ---------------------------------------------------------------------------
// Paste this whole file into:
//   Firebase console -> Firestore Database -> Rules -> Publish
//
// WHAT THESE RULES DO
//   There is no sign-in. Everyone who opens the site is signed in anonymously
//   and every visitor is identical as far as Firestore is concerned, so these
//   rules cannot tell one person from another.
//
//   What they still do is keep the data well-formed and keep history honest:
//   valid categories, sane numbers, a month that looks like a month, and no
//   rewriting an entry once it is written.
//
//   Houses are created from inside the app, so the roster can no longer be
//   hardcoded here.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function shortString(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    // -------------------------------------------------------------- houses --
    match /houses/{houseId} {
      allow read: if signedIn();

      allow create, update: if signedIn()
        && shortString(request.resource.data.name, 40)
        && request.resource.data.members is list
        && request.resource.data.members.size() > 0
        && request.resource.data.members.size() <= 40;

      // Removing a house only takes it off the list. Its entries and standings
      // are untouched, so no one's logged work is ever lost this way.
      allow delete: if signedIn();
    }

    // ------------------------------------------------------------- entries --
    match /entries/{entryId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && shortString(request.resource.data.houseId, 40)
        && shortString(request.resource.data.member, 60)
        && request.resource.data.month is string
        && request.resource.data.month.matches('[0-9]{4}-[0-9]{2}')
        && request.resource.data.category in ['books', 'quran', 'cevsen']
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 10000
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 60;

      // Append-only. A wrong number is deleted and re-added, never silently
      // rewritten, so the history stays honest.
      allow update: if false;

      allow delete: if signedIn();
    }

    // ----------------------------------------------------------- standings --
    // Totals only, no member detail. Keyed "<month>_<houseId>".
    match /standings/{docId} {
      allow read: if signedIn();

      allow write: if signedIn()
        && shortString(request.resource.data.houseId, 40)
        && request.resource.data.month is string
        && request.resource.data.month.matches('[0-9]{4}-[0-9]{2}')
        && docId == request.resource.data.month + '_' + request.resource.data.houseId
        && request.resource.data.totals.keys().hasOnly(['books', 'quran', 'cevsen'])
        && request.resource.data.qualified is bool;

      allow delete: if false;
    }

    // Everything else is closed. The old config/gate document that held the
    // Ev Abi password hash is no longer read or written by anything.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
